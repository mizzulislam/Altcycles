# ==============================================================================
# Altcycles — Contoh Variabel Lingkungan (.env.example)
# Salin berkas ini menjadi .env.local untuk pengembangan lokal.
# JANGAN PERNAH menyimpan API secret / service_role key di frontend atau repo!
# ==============================================================================

# URL proyek Supabase (Tier Gratis)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / Public Key Supabase (aman untuk browser karena seluruh tabel dilindungi RLS)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Site Key publik Cloudflare Turnstile (Tier Gratis) untuk Portal Pembeli
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Batas waktu sesi tidak aktif dalam menit (FR-A4, default: 30)
VITE_IDLE_TIMEOUT_MINUTES=30

# Mode demo lokal tanpa koneksi Supabase Cloud (opsional saat pengembangan UI lokal: true | false)
VITE_DEMO_MODE=false

